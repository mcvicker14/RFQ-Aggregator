# Copy this file to .env and fill in real values. Never commit the real .env file.
# See docs/SECURITY.md for how these are used.

ENV=development

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg://principal_oi_app:CHANGE_ME@localhost:5432/principal_oi

# Generate a long random string for production, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=720

# Must match the URL the frontend is served from (CORS)
FRONTEND_ORIGIN=http://localhost:3000

# Local file storage for uploaded documents
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# --- Initial administrator account, used only by `python -m seed.seed` ---
# Set these to choose your own login instead of the script generating one.
# See docs/SECURITY.md. Never commit real values here.
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_NAME=
ADMIN_INITIAL_PASSWORD=

# --- Optional external integrations ---
# SAM.gov: sign in at sam.gov -> Account Details -> request a "Public API Key".
# Without this, SAM.gov sync is disabled and the UI says so explicitly.
SAM_GOV_API_KEY=

# Anthropic: create a key at https://console.anthropic.com/settings/keys
# Without this, AI solicitation analysis is disabled and the UI says so explicitly.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# SOQ Status Board: URL and shared secret for the Google Apps Script Web App bound to
# the SOQ Status Board sheet (see google-apps-script/status_board_sync.gs). Without
# these, "Track + Add to Status Board" still tracks the Opportunity in the app but
# reports the Status Board sync as not-configured rather than failing. See
# docs/SECURITY.md.
STATUS_BOARD_WEBHOOK_URL=
STATUS_BOARD_WEBHOOK_SECRET=
# Owner Submit editing stays disabled until the reviewed source setup is complete.
STATUS_BOARD_SUBMIT_EDITS_ENABLED=false
STATUS_BOARD_RECONCILIATION_ENABLED=false

# COREWORKS RFQwire: URL and shared secret for the Google Apps Script Web App
# authorized against the Gmail account that receives forwarded COREWORKS digest
# emails (see google-apps-script/coreworks_sync.gs). This app holds no Gmail/Google
# credentials of any kind — the script does the actual searching and reads, and both
# directions (this app asking it for new mail, and it pushing new mail to this app's
# /api/intelligence/coreworks-ingest) are authenticated by this one shared secret.
# Without these, COREWORKS sync is disabled and the UI says so explicitly.
COREWORKS_APPS_SCRIPT_URL=
COREWORKS_WEBHOOK_SECRET=

# Scheduled-sync trigger (APEX daily 6PM Central only — COREWORKS's automatic check is
# now the Apps Script's own time-driven trigger, see above): a shared secret for an
# external scheduler (e.g. the .github/workflows/scheduled-sync.yml GitHub Actions
# workflow in this repo) to call POST /api/intelligence/scheduled-sync-check.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SCHEDULED_SYNC_SECRET=

# --- Phase 2 integrations (not required for the MVP) ---
STORAGE_BACKEND=local
S3_BUCKET=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERTS_FROM_EMAIL=
